{
  "name": "@soko/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean:dev": "rm -rf node_modules/.vite dist",
    "dev": "vite",
    "dev:poll": "VITE_USE_POLLING=true vite",
    "preview": "vite preview --host 127.0.0.1",
    "restart:dev": "pnpm clean:dev && pnpm dev",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@soko/tool-core": "workspace:*",
    "@soko/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2"
  }
}
