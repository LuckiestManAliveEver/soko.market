{
  "name": "Soko.market",
  "short_name": "Soko",
  "description": "Mobile-first business shell for Soko.market merchants.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "orientation": "any",
  "background_color": "#f4f6f2",
  "theme_color": "#117a4f",
  "categories": ["business", "productivity", "shopping"],
  "shortcuts": [
    {
      "name": "Marketplace",
      "short_name": "Marketplace",
      "url": "/marketplace",
      "icons": [{ "src": "/icons/soko-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Seller workspace",
      "short_name": "Workspace",
      "url": "/workspace",
      "icons": [{ "src": "/icons/soko-icon-192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    {
      "src": "/icons/soko-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/soko-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/soko-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/soko-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
