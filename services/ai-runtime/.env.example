# Vercel executes inference only - it never sees Neon's Postgres, business/chat state, or tool
# credentials. Run locally with `pnpm --filter @soko/ai-runtime dev` (Vercel CLI dev server); see
# docs/deployment/vercel-inference.md.

# Shared bearer secret with the Render API (services/api's SOKO_INFERENCE_SERVICE_TOKEN) - must be
# identical on both sides and at least 32 characters.
SOKO_INFERENCE_SERVICE_TOKEN=a30b3c0bcd66528537039cf4b5aada5634c0db48bbf7dcd2

# Runtime backend. Use `huggingface` to run the deployed inference service against Hugging Face
# Inference Providers using an OSS Hub model id. Keep `llama-cpp` for the existing downloaded-GGUF
# path.
INFERENCE_PROVIDER=huggingface
HF_TOKEN=
# JSON map from Soko catalog model IDs to Hugging Face Hub model IDs.
HF_MODEL_MAP={"smollm2-360m":"HuggingFaceTB/SmolLM2-1.7B-Instruct","gpt-oss-20b":"openai/gpt-oss-20b"}
# Optional fallback for IDs not present in HF_MODEL_MAP. Leave empty for strict allowlisting.
HF_MODEL_ID=
HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1/

# Comma-separated hostnames this service is allowed to download model artifacts from (SSRF guard
# in src/artifact-loader.ts). Must include Neon's object-storage hostname, matching
# NEON_MODEL_STORAGE_ENDPOINT on the Render side. Required only when INFERENCE_PROVIDER=llama-cpp.
MODEL_ARTIFACT_ALLOWED_HOSTS=

VERCEL_MAX_ARTIFACT_BYTES=450000000
INFERENCE_MAX_INPUT_CHARACTERS=64000
INFERENCE_MAX_OUTPUT_TOKENS=512
# Bounded LRU model cache size for one warm serverless instance (src/runtime-cache.ts). Keep small
# - each entry holds a fully loaded GGUF model in memory.
INFERENCE_RUNTIME_CACHE_ENTRIES=1
