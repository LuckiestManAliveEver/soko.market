{
  "name": "@soko/ai-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @soko/shared-types build && pnpm build:package",
    "build:package": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "vercel dev",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@soko/shared-types": "workspace:*",
    "node-llama-cpp": "3.18.1"
  }
}
