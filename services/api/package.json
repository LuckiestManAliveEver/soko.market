{
  "name": "@soko/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "db:backup": "node scripts/backup-db.mjs",
    "db:backup:verify": "node scripts/verify-backup-db.mjs",
    "db:health": "node scripts/check-db-health.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:purge-shops": "node scripts/purge-shop-deletions.mjs",
    "db:purge-accounts": "node scripts/purge-account-deletions.mjs",
    "db:verify-schema": "node scripts/verify-db-schema.mjs",
    "vapid:generate": "node scripts/generate-vapid-env.mjs",
    "db:rollback": "node scripts/rollback-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@soko/ai-runtime": "workspace:*",
    "@soko/business-core": "workspace:*",
    "@soko/event-core": "workspace:*",
    "@soko/shared-types": "workspace:*",
    "@soko/sync-core": "workspace:*",
    "@soko/tool-core": "workspace:*",
    "fastify": "^5.2.1",
    "pg": "^8.22.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1"
  }
}
