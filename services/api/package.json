{
  "name": "@soko/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@soko/ai-runtime": "workspace:*",
    "@soko/business-core": "workspace:*",
    "@soko/event-core": "workspace:*",
    "@soko/shared-types": "workspace:*",
    "@soko/sync-core": "workspace:*",
    "@soko/tool-core": "workspace:*",
    "fastify": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
