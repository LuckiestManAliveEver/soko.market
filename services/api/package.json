{
  "name": "@soko/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "db:backfill-native-runtime": "node scripts/backfill-native-runtime-bindings.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:backup:verify": "node scripts/verify-backup-db.mjs",
    "db:health": "node scripts/check-db-health.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:purge-shops": "node scripts/purge-shop-deletions.mjs",
    "db:purge-accounts": "node scripts/purge-account-deletions.mjs",
    "db:verify-schema": "node scripts/verify-db-schema.mjs",
    "phone-identities:audit": "tsx scripts/audit-phone-identities.ts",
    "phone-identities:normalize": "tsx scripts/audit-phone-identities.ts",
    "eval:ai": "tsx scripts/run-ai-eval.ts",
    "vapid:generate": "node scripts/generate-vapid-env.mjs",
    "db:rollback": "node scripts/rollback-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@simplewebauthn/server": "^13.0.0",
    "@soko/business-core": "workspace:*",
    "@soko/event-core": "workspace:*",
    "@soko/shared-types": "workspace:*",
    "@soko/sync-core": "workspace:*",
    "@soko/tool-core": "workspace:*",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.9",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "web-push": "^3.6.7",
    "xlsx": "file:../../vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1"
  }
}
