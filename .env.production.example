# Copy to .env.production on the Hetzner host. Never commit the populated file.
NODE_ENV=production

APP_DOMAIN=soko.market
API_DOMAIN=api.soko.market
ACME_EMAIL=
FRONTEND_ORIGIN=https://soko.market
WEB_PUBLIC_URL=https://soko.market
AUTH_ALLOWED_REDIRECT_ORIGINS=https://soko.market
WEBAUTHN_RP_ID=soko.market

POSTGRES_DB=soko_market
POSTGRES_USER=soko_app
POSTGRES_PASSWORD=
# URL-encode reserved characters in passwords. Both URLs intentionally target the same internal DB.
DATABASE_URL=postgresql://soko_app:PERCENT_ENCODED_PASSWORD@postgres:5432/soko_market
DIRECT_DATABASE_URL=postgresql://soko_app:PERCENT_ENCODED_PASSWORD@postgres:5432/soko_market
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=15000
DB_SLOW_QUERY_MS=1000

REDIS_PASSWORD=
REDIS_URL=redis://:PERCENT_ENCODED_PASSWORD@redis:6379

R2_ACCOUNT_ID=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
REQUIRE_OBJECT_STORAGE=true

BACKUP_ENCRYPTION_PASSWORD=
BACKUP_RETENTION_DAYS=14
BACKUP_R2_PREFIX=database-backups
# Daily UTC cron only: minute hour * * *
BACKUP_SCHEDULE=17 2 * * *

OTP_HMAC_SECRET=
PIN_HASH_SECRET=
AUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_TOKEN_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=true

INFERENCE_SERVICE_TOKEN=
INFERENCE_JOB_SIGNING_SECRET=
BACKEND_INFERENCE_ENABLED=true
BACKEND_INFERENCE_REQUIRED=false
INFERENCE_CLIENT_FIRST=true
INFERENCE_OWNER_NODE_ENABLED=true
INFERENCE_CLOUD_FALLBACK_ENABLED=false
INFERENCE_CLOUD_PROVIDER=
INFERENCE_CLOUD_MODEL_ALLOWLIST=
INFERENCE_CLOUD_MONTHLY_TOKEN_BUDGET=100000
INFERENCE_MAX_FALLBACKS=2
SOKO_PRIMARY_MODEL_ID=qwen2.5-0.5b-android
SOKO_PRIMARY_PROVIDER_MODEL_ID=qwen2.5:0.5b
MODEL_AUTO_INSTALL=false
MODEL_MIN_FREE_BYTES=2147483648
HF_TOKEN=

OCR_PROFILE=balanced
OCR_ENGINE_PRIMARY=paddleocr
OCR_ENGINE_FALLBACK=tesseract
OCR_RETAIN_SOURCE_OBJECTS=false
OCR_CONCURRENCY=1
OCR_JOB_TIMEOUT_SECONDS=120
MALWARE_SCANNER_ENABLED=false
MALWARE_SCANNER_URL=
MALWARE_SCANNER_SECRET=

VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RESEND_API_KEY=
SOKO_EMAIL_FROM=
NETWORK_INVITE_WEBHOOK_URL=
NETWORK_INVITE_WEBHOOK_SECRET=
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_ENABLED=false
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_TIKTOK_ENABLED=false
OAUTH_TIKTOK_CLIENT_ID=
OAUTH_TIKTOK_CLIENT_SECRET=
OAUTH_MICROSOFT_ENABLED=false
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
ACCOUNT_DELETION_PROCESSORS_JSON=
ACCOUNT_DELETION_WEBHOOK_SECRET=
OPENAI_API_KEY=

# Vercel project variables (configure in Vercel, not on the API container).
VITE_API_BASE_URL=https://api.soko.market
VITE_DEPLOYMENT_ENV=production
VITE_BROWSER_LOCAL_INFERENCE_ENABLED=true
VITE_INFERENCE_CLIENT_FIRST=true
VITE_INFERENCE_BROWSER_WEBGPU_ENABLED=true
VITE_INFERENCE_BROWSER_WASM_ENABLED=true
VITE_INFERENCE_NATIVE_BRIDGE_ENABLED=true
VITE_INFERENCE_OWNER_NODE_ENABLED=true
VITE_INFERENCE_CLOUD_FALLBACK_ENABLED=false
VITE_INFERENCE_MAX_FALLBACKS=3

# CI image references. IMAGE_TAG should be an immutable commit SHA.
IMAGE_TAG=local
API_IMAGE=soko-market-api
AI_RUNTIME_IMAGE=soko-market-ai-runtime
OCR_IMAGE=soko-market-receipt-ocr
BACKUP_IMAGE=soko-market-postgres-backup
