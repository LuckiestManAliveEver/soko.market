{
  "name": "soko-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./services/api/dist/index.js",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.19.0 <23.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.5",
      "find-my-way": "^9.7.0",
      "tar": "^7.5.21",
      "sharp": "^0.35.0"
    }
  },
  "scripts": {
    "android:identity:gate": "node scripts/verify-android-release-identity.mjs --require-approved",
    "android:identity:verify": "node scripts/verify-android-release-identity.mjs",
    "android:legal:gate": "node scripts/verify-play-legal-readiness.mjs --require-approved",
    "android:legal:verify": "node scripts/verify-play-legal-readiness.mjs",
    "build": "pnpm -r --if-present build",
    "build:production": "pnpm check:esm-relative-imports && pnpm build:production:workspace && pnpm check:production-imports && pnpm check:retired-runtime-references && pnpm check:retired-device-model-references && pnpm check:render-inference-boundaries",
    "build:production:workspace": "pnpm -r --filter \"./packages/**\" --if-present build && pnpm --filter @soko/ai-runtime build:package && pnpm --filter @soko/api build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:esm-relative-imports": "node scripts/check-esm-relative-imports.mjs",
    "check:production-imports": "node scripts/check-production-imports.mjs",
    "check:retired-runtime-references": "node scripts/check-retired-runtime-references.mjs",
    "check:retired-device-model-references": "node scripts/check-retired-device-model-references.mjs",
    "check:render-inference-boundaries": "node scripts/check-render-inference-boundaries.mjs",
    "check:shellview-boundary": "node scripts/check-shellview-boundary.mjs",
    "check:web-bundle-budgets": "pnpm --filter @soko/web build && node scripts/check-web-bundle-budgets.mjs",
    "ci": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm check:esm-relative-imports && pnpm android:identity:verify && pnpm android:legal:verify && pnpm check:boundaries && pnpm check:shellview-boundary && pnpm check:web-bundle-budgets",
    "clean:dev": "pnpm --filter @soko/web clean:dev",
    "dev": "pnpm -r --parallel --stream --filter @soko/api --filter @soko/web run dev",
    "dev:api": "pnpm --filter @soko/api dev",
    "dev:web": "pnpm --filter @soko/web dev",
    "dev:web:poll": "pnpm --filter @soko/web dev:poll",
    "dev:stack": "docker compose up -d postgres redis",
    "dev:stack:down": "docker compose down",
    "db:backup": "pnpm --filter @soko/api db:backup",
    "db:backup:verify": "pnpm --filter @soko/api db:backup:verify",
    "db:backfill-native-runtime": "pnpm --filter @soko/api db:backfill-native-runtime",
    "db:grant-platform-operator": "pnpm --filter @soko/api db:grant-platform-operator",
    "db:health": "pnpm --filter @soko/api db:health",
    "db:migrate": "pnpm --filter @soko/api db:migrate",
    "db:purge-shops": "pnpm --filter @soko/api db:purge-shops",
    "db:purge-accounts": "pnpm --filter @soko/api db:purge-accounts",
    "db:verify-schema": "pnpm --filter @soko/api db:verify-schema",
    "db:verify-neon-production": "REQUIRE_NEON_DATABASE=true pnpm --filter @soko/api db:verify-schema",
    "db:rollback": "pnpm --filter @soko/api db:rollback",
    "db:restore": "pnpm --filter @soko/api db:restore",
    "eval:ai": "pnpm --filter @soko/api eval:ai",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "health:api": "node scripts/health-check.mjs",
    "inference:build": "pnpm --filter @soko/ai-runtime build",
    "inference:health": "node scripts/inference-health.mjs",
    "inference:probe": "node scripts/inference-probe.mjs",
    "inference:live-probe": "node scripts/ai-runtime-live-inference-probe.mjs",
    "inference:dev": "pnpm --filter @soko/ai-runtime dev",
    "lint": "eslint . --max-warnings=0",
    "restart:dev": "pnpm clean:dev && pnpm dev",
    "start": "pnpm --filter @soko/api start",
    "test": "vitest run",
    "test:mcp:openai": "node scripts/test-openai-soko-mcp.mjs",
    "test:live-model-runtime": "RUN_LIVE_MODEL_RUNTIME_TEST=true vitest run tests/live-render-model-runtime.test.ts",
    "test:ui-cert": "playwright test e2e/responsive-accessibility.spec.ts",
    "typecheck": "pnpm -r --filter \"./packages/**\" --if-present build && pnpm -r --if-present typecheck",
    "verify:production-runtime": "node --env-file-if-exists=.env scripts/verify-production-runtime.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.2",
    "drizzle-orm": "^0.38.4",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "standardwebhooks": "^1.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
