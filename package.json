{
  "name": "soko-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19.0 <21.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "ci": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm check:boundaries",
    "dev": "pnpm -r --parallel --stream --filter @soko/api --filter @soko/web run dev",
    "dev:api": "pnpm --filter @soko/api dev",
    "dev:web": "pnpm --filter @soko/web dev",
    "dev:stack": "docker compose up -d postgres redis",
    "dev:stack:down": "docker compose down",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "health:api": "node scripts/health-check.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.2",
    "drizzle-orm": "^0.38.4",
    "eslint": "^9.18.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
